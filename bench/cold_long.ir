# 6 cold variables live from the start to the end, a hot loop of 6 short-lived temporaries in between
# expect: 103950 33
func cold_long
block entry:
  v0 = const 1
  v1 = const 3
  v2 = const 4
  v3 = const 5
  v4 = const 6
  v5 = const 7
  v6 = const 8
  v7 = const 0
  v8 = const 0
  v9 = const 100
  jmp head1
block head1:
  v10 = lt v8 v9
  br v10 body2 out3
block body2:
  v11 = const 1
  v12 = mul v8 v11
  v13 = const 2
  v14 = mul v8 v13
  v15 = const 3
  v16 = mul v8 v15
  v17 = const 4
  v18 = mul v8 v17
  v19 = const 5
  v20 = mul v8 v19
  v21 = const 6
  v22 = mul v8 v21
  v7 = add v7 v12
  v7 = add v7 v14
  v7 = add v7 v16
  v7 = add v7 v18
  v7 = add v7 v20
  v7 = add v7 v22
  v8 = add v8 v0
  jmp head1
block out3:
  v23 = const 0
  v23 = add v23 v1
  v23 = add v23 v2
  v23 = add v23 v3
  v23 = add v23 v4
  v23 = add v23 v5
  v23 = add v23 v6
  print v7
  print v23
  ret
