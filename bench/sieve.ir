# count primes below 200 with a sieve of flags in memory; nested loops
# expect: 46
func sieve
block entry:
  v0 = const 1
  v1 = const 200
  v2 = const 0
  v3 = const 2
  jmp head1
block head1:
  v4 = lt v3 v1
  br v4 body2 out3
block body2:
  v5 = load v3
  v6 = lt v5 v0
  br v6 prime4 composite5
block prime4:
  v2 = add v2 v0
  v7 = add v3 v3
  jmp head6
block head6:
  v8 = lt v7 v1
  br v8 body7 out8
block body7:
  store v7 v0
  v7 = add v7 v3
  jmp head6
block out8:
  jmp composite5
block composite5:
  v3 = add v3 v0
  jmp head1
block out3:
  print v2
  ret
